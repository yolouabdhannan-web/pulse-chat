{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://pulse-chat-hecm.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://pulse-chat-hecm.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
